NETWORK=testnet
DRY_RUN=true
PRIVATE_KEY=
# Testnet DreamDEX venue. Required: without it, activeMarkets throws once more
# than one venue has live markets at once, since it will not guess which one to quote.
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

MM_REFRESH_MS=15000
MM_RUN_SECONDS=0

MM_MAX_MARKETS=3
MM_MIN_MARKET_TTL_MIN=10
MM_MAX_MARKET_TTL_MIN=40
MM_MIN_TTL_SEC=150

MM_QUOTE_NOTIONAL=2
MM_PER_MARKET_MAX_POSITION=8
MM_PER_MARKET_MAX_NOTIONAL=6
MM_GLOBAL_MAX_NOTIONAL=12
MM_SKEW_PER_UNIT=0.02
MM_REQUOTE_THRESHOLD=0.006

MM_BASE_HALF_SPREAD=0.006
MM_VOL_SPREAD_MULTIPLIER=0.01
MM_MIN_HALF_SPREAD=0.004
MM_MAX_HALF_SPREAD=0.05

MM_TREND_LOOKBACK_MS=60000
MM_TREND_WIDEN_PCT=0.003
MM_TREND_PAUSE_PCT=0.006
MM_TREND_WIDEN_MULTIPLIER=3

MM_INVENTORY_PER_MARKET=4
MM_FALLBACK_VOL=0.6
